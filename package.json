{
  "name": "crimpd",
  "version": "1.0.0",
  "description": "Crimpy — a climbing-training PWA (fingerboard, weighted pull-ups, repeaters).",
  "private": true,
  "scripts": {
    "build:css": "tailwindcss -c tailwind.config.js -i css/tailwind.input.css -o css/tailwind.css --minify",
    "watch:css": "tailwindcss -c tailwind.config.js -i css/tailwind.input.css -o css/tailwind.css --watch",
    "build:www": "bash scripts-build-www.sh",
    "android:sync": "npm run build:www && cap sync android",
    "android:build": "npm run android:sync && cd android && ./gradlew assembleDebug",
    "test": "node test/merge.test.mjs && node test/notify.test.mjs"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.1",
    "tailwindcss": "^3.4.0"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.1",
    "@capacitor/core": "^6.2.1",
    "@capacitor/local-notifications": "^6.1.3"
  }
}
