{
  "name": "crimpd",
  "version": "1.0.0",
  "description": "Crimpy — a climbing-training PWA (fingerboard, weighted pull-ups, repeaters).",
  "private": true,
  "scripts": {
    "build:css": "tailwindcss -c tailwind.config.js -i css/tailwind.input.css -o css/tailwind.css --minify",
    "watch:css": "tailwindcss -c tailwind.config.js -i css/tailwind.input.css -o css/tailwind.css --watch",
    "test": "node test/merge.test.mjs"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.0"
  }
}
