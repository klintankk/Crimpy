# Copy to server/.env (or set these in the systemd unit) and adjust.

# Port the sync server listens on (tailscale serve will proxy to this).
PORT=8787

# Absolute path to the Crimpy git working tree on the Pi.
REPO_DIR=/home/pi/Crimpy

# Canonical data file (relative to REPO_DIR).
DATA_PATH=data/backup.json

# Git target for pushing the canonical file.
GIT_BRANCH=main
GIT_REMOTE=origin

# Set PUSH=0 to merge/serve only and skip committing/pushing to GitHub.
PUSH=1

# Serve the static app from REPO_DIR too (SERVE_STATIC=0 to disable).
SERVE_STATIC=1

# CORS: leave as * if the app is served by this same server. If you host the
# app elsewhere (e.g. GitHub Pages), set this to that exact origin.
ALLOWED_ORIGIN=*

# Optional shared secret. If set, clients must send it as X-Sync-Token
# (configure it in the app's Settings -> Sync server). Recommended even on a
# tailnet for defense in depth.
SYNC_TOKEN=

# Commit identity used by the Pi.
GIT_AUTHOR_NAME=Crimpy Pi
GIT_AUTHOR_EMAIL=crimpy@localhost
